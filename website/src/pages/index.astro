---
import Home from "../components/Home";
import Page from "../layouts/Page.astro";

const title = "redakt | Redact before you prompt";
const description =
  "Mask detected passwords and access tokens in logs and .env files before sharing them. redakt runs offline on your CPU.";
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "redakt",
  description,
  url: Astro.site?.href,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  keywords: ["log redaction CLI", "local text redaction"],
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  sameAs: [
    "https://github.com/thoriqakbar0/redakt",
  ],
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
};
---
<Page {title} {description}>
  <Fragment slot="head">
    <meta name="is-agentic-site-type" content="business" />
    <link rel="alternate" type="text/markdown" href="/" />
    <script type="application/ld+json" set:html={JSON.stringify(software)} />
  </Fragment>
  <Home client:load />
</Page>
